---
// 分类总览页 /collections/
// 作用：给 5 个分类落地页一个父级枢纽，集中传递内链权重（避免 /collections/ 直接 404）
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, SITE } from '../../consts';
import { CATEGORY_CONTENT } from '../../data/category-content';

const products = await getCollection('products');

const collections = CATEGORIES.map((c) => ({
  category: c,
  count: products.filter((p) => p.data.category === c.slug).length,
  content: CATEGORY_CONTENT[c.slug],
}));

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Product Collections',
  description:
    'Browse ONEPENUT pet product collections — carriers, harnesses, recovery collars, strollers and accessories for wholesale and OEM.',
  url: `${SITE.url}/collections/`,
  hasPart: collections.map((c) => ({
    '@type': 'CollectionPage',
    name: c.category.name,
    url: new URL(c.category.path, SITE.url).href,
  })),
});
---

<Layout
  title="Pet Product Collections — Wholesale & OEM"
  description="Browse all ONEPENUT pet product collections: carrier bags, harnesses and leashes, recovery collars, strollers and accessories. Wholesale, OEM and ODM."
>
  <script type="application/ld+json" set:html={schema}></script>

  <section class="border-b border-milk-tea/60 bg-white/50">
    <div class="container-site py-8 md:py-12">
      <nav class="flex flex-wrap items-center gap-2 text-sm text-stone" aria-label="Breadcrumb">
        <a href="/" class="hover:text-olive-dark">Home</a>
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
        <span class="text-dark-brown">Collections</span>
      </nav>

      <div class="mt-8 max-w-3xl">
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">Catalog</span>
        <h1 class="mt-3 font-display text-4xl font-bold text-dark-brown md:text-5xl">
          Product Collections
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone">
          Five core ranges covering the full pet travel journey — from carrier
          bags and walking gear to recovery care and everyday essentials. All
          available for wholesale, OEM and ODM.
        </p>
      </div>
    </div>
  </section>

  <section class="container-site py-14 md:py-20">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {collections.map(({ category, count, content }) => (
        <a
          href={category.path}
          class="group flex flex-col overflow-hidden rounded-3xl border border-milk-tea/60 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-hover"
        >
          <div class="aspect-[16/9] overflow-hidden bg-milk-tea/30">
            {products.find((p) => p.data.category === category.slug)?.data.image ? (
              <img
                src={products.find((p) => p.data.category === category.slug)?.data.image}
                alt={category.name}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-olive/10 via-milk-tea/30 to-caramel/10 text-olive/40">
                <svg class="h-12 w-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={category.icon}></path>
                </svg>
              </div>
            )}
          </div>
          <div class="flex flex-1 flex-col p-6">
            <span class="text-xs font-semibold uppercase tracking-[0.15em] text-caramel">
              {category.tagline}
            </span>
            <h2 class="mt-2 font-display text-xl font-bold text-dark-brown transition-colors group-hover:text-olive-dark">
              {content?.h1 || category.name}
            </h2>
            <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-stone">
              {category.description}
            </p>
            <div class="mt-5 flex items-center justify-between border-t border-milk-tea/40 pt-4">
              <span class="text-sm font-medium text-stone">{count} models</span>
              <span class="text-sm font-semibold text-olive-dark">View range →</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/products" class="btn-caramel">Browse all products</a>
    </div>
  </section>
</Layout>
