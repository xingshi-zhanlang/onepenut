---
// 分类落地页 /collections/<segment>/
// 目的：让 5 个核心品类各有独立 URL，承载分类商业词，并作为产品详情页的内链枢纽。
// SEO：独立 title / description / H1 + 分类商品网格 + B2B 采购信息 + 结构化数据
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, SITE, whatsappLink } from '../../consts';
import { CATEGORY_CONTENT, TRADE_TERMS } from '../../data/category-content';

export async function getStaticPaths() {
  const allProducts = await getCollection('products');
  return CATEGORIES.map((c) => ({
    params: { category: c.path.split('/').filter(Boolean).pop() as string },
    props: {
      category: c,
      products: allProducts.filter((p) => p.data.category === c.slug),
    },
  }));
}

const { category, products } = Astro.props;
const content = CATEGORY_CONTENT[category.slug];
const pageUrl = new URL(category.path, SITE.url).href;

const inquiryMsg = `Hello ONEPENUT, I'm interested in your ${category.name} range. Please send me your wholesale catalog and pricing.`;
const inquiryLink = whatsappLink(inquiryMsg);

// 其他分类（内链区）
const otherCategories = CATEGORIES.filter((c) => c.slug !== category.slug);

// 结构化数据：CollectionPage + ItemList + BreadcrumbList + FAQPage
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: content.seoTitle,
      description: content.seoDescription,
      url: pageUrl,
      isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'ItemList',
      name: category.name,
      numberOfItems: products.length,
      itemListElement: products.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/products/${p.slug}/`, SITE.url).href,
        name: p.data.title,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Products', item: `${SITE.url}/products/` },
        { '@type': 'ListItem', position: 3, name: category.name, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: content.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<Layout title={content.seoTitle} description={content.seoDescription}>
  <script type="application/ld+json" set:html={schema}></script>

  <!-- 页头 -->
  <section class="border-b border-milk-tea/60 bg-white/50">
    <div class="container-site py-8 md:py-12">
      <!-- 面包屑 -->
      <nav class="flex flex-wrap items-center gap-2 text-sm text-stone" aria-label="Breadcrumb">
        <a href="/" class="hover:text-olive-dark">Home</a>
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
        <a href="/products" class="hover:text-olive-dark">Products</a>
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
        <span class="text-dark-brown">{category.name}</span>
      </nav>

      <div class="mt-8 max-w-3xl">
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">
          {category.tagline}
        </span>
        <h1 class="mt-3 font-display text-4xl font-bold text-dark-brown md:text-5xl">
          {content.h1}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone">{category.description}</p>
        <p class="mt-4 text-sm font-medium text-olive-dark">
          {products.length} models available for wholesale, OEM &amp; ODM
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/quote" class="btn-caramel">Request a Quote</a>
          <a
            href={inquiryLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-wa"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.973-1.041z"/>
            </svg>
            Ask on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 分类介绍 -->
  <section class="container-site py-12 md:py-16">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="space-y-4 text-base leading-relaxed text-stone">
          {content.intro.map((para) => <p>{para}</p>)}
        </div>
      </div>
      <aside class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
        <h2 class="font-display text-lg font-bold text-dark-brown">Sourcing this range?</h2>
        <p class="mt-2 text-sm leading-relaxed text-stone">
          Send us your target market, price point and quantity. We will come back
          with model options, sample arrangements and honest feedback.
        </p>
        <ul class="mt-5 space-y-3 text-sm text-stone">
          {[
            'Low MOQ trial orders reviewed case by case',
            'Custom logo, colour, size and packaging',
            'Sample approved before bulk production',
            'Full export documentation support',
          ].map((item) => (
            <li class="flex gap-2.5">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-olive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12l2 2 4-4"></path>
                <circle cx="12" cy="12" r="9"></circle>
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <a href="/quote" class="btn-caramel mt-6 w-full justify-center">Get a Quote</a>
      </aside>
    </div>
  </section>

  <!-- 商品网格 -->
  <section class="container-site pb-14 md:pb-20">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="font-display text-2xl font-bold text-dark-brown md:text-3xl">
          {category.name} collection
        </h2>
        <p class="mt-2 text-sm text-stone">
          Every model below can be built to your own specification.
        </p>
      </div>
      <a href="/products" class="text-sm font-semibold text-olive-dark hover:underline">
        View all products →
      </a>
    </div>

    {products.length > 0 ? (
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
    ) : (
      <div class="mt-8 rounded-3xl border border-milk-tea/60 bg-white p-10 text-center shadow-card">
        <p class="text-lg font-medium text-dark-brown">Models are being added to this range.</p>
        <p class="mt-2 text-sm text-stone">
          Contact us — we can still develop this category to your specification.
        </p>
      </div>
    )}
  </section>

  <!-- 采购关注点 -->
  <section class="bg-white/50 py-14 md:py-20">
    <div class="container-site">
      <div class="max-w-2xl">
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">
          What buyers check
        </span>
        <h2 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl">
          What buyers check before ordering
        </h2>
        <p class="mt-3 text-stone">
          The points below are the ones our buyers raise most often at sample
          stage. Bring them up early and your first order lands right.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {content.highlights.map((h) => (
          <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
            <h3 class="font-display text-lg font-bold text-dark-brown">{h.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone">{h.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 采购条款 -->
  <section class="container-site py-14 md:py-20">
    <div class="max-w-2xl">
      <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">
        Wholesale &amp; OEM
      </span>
      <h2 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl">
        How we work with buyers
      </h2>
      <p class="mt-3 text-stone">
        Applies to every range on this site. Exact figures depend on the model,
        so confirm them with us before you plan an order.
      </p>
    </div>

    <dl class="mt-10 grid gap-x-10 gap-y-6 md:grid-cols-2">
      {TRADE_TERMS.map((t) => (
        <div class="border-t border-milk-tea/60 pt-5">
          <dt class="font-semibold text-dark-brown">{t.label}</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-stone">{t.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- 常见问题 -->
  <section class="bg-white/50 py-14 md:py-20">
    <div class="container-site grid gap-10 lg:grid-cols-3">
      <div>
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">FAQ</span>
        <h2 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl">
          {category.name} questions
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-stone">
          Still unsure about something? Ask us directly — we answer honestly,
          including when a product is not the right fit for your market.
        </p>
        <a href="/contact" class="mt-5 inline-flex text-sm font-semibold text-olive-dark hover:underline">
          Contact our team →
        </a>
      </div>

      <div class="lg:col-span-2">
        <div class="space-y-4">
          {content.faqs.map((f) => (
            <details class="group rounded-2xl border border-milk-tea/60 bg-white p-5 shadow-card">
              <summary class="flex cursor-pointer items-start justify-between gap-4 font-semibold text-dark-brown marker:content-none">
                <span>{f.q}</span>
                <svg class="mt-1 h-5 w-5 shrink-0 text-stone transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-stone">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 其他分类（内链） -->
  <section class="container-site py-14 md:py-20">
    <h2 class="font-display text-2xl font-bold text-dark-brown md:text-3xl">
      Explore other collections
    </h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {otherCategories.map((c) => (
        <a
          href={c.path}
          class="group flex flex-col rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-hover"
        >
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-olive/10 text-olive-dark">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={c.icon}></path>
            </svg>
          </span>
          <h3 class="mt-4 font-display text-lg font-bold text-dark-brown transition-colors group-hover:text-olive-dark">
            {c.name}
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-stone">{c.tagline}</p>
          <span class="mt-4 text-sm font-semibold text-olive-dark">View range →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-olive to-olive-dark py-14 md:py-16">
    <div class="container-site text-center">
      <h2 class="font-display text-3xl font-bold text-cream md:text-4xl">
        Looking for {category.name.toLowerCase()}?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-cream/80">
        Tell us your target market, quantities and branding needs. We will reply
        within 24 hours with options and pricing guidance.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/quote" class="btn-caramel text-base">Request a Quote</a>
        <a
          href={inquiryLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-cream/40 px-5 py-2.5 text-sm font-semibold text-cream transition-colors hover:bg-cream/10"
        >
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>
</Layout>
