const specPoints = [
  {
    title: 'Carry position and strap geometry',
    desc: 'Chest, crossbody, shoulder and tote are not marketing labels — they change the strap anchors, the load path and how the bag sits on the body. Tell us the carry position and we set the strap geometry to match rather than adapting a single frame.',
  },
  {
    title: 'Opening and how the pet goes in',
    desc: 'A top-load opening, a side zip, a full front drop or a wide mouth all change how easy the bag is to use with one hand. For a cat owner, a top opening with a drawcord is usually the deciding feature; for a small dog, a front panel the pet can be lowered into works better.',
  },
  {
    title: 'Ventilation and mesh placement',
    desc: 'Mesh on one face, three faces or a full breathable panel — the mesh budget decides both airflow and how visible the pet is. High-density mesh is the usual specification for markets that sell on comfort rather than price.',
  },
  {
    title: 'Structure and base support',
    desc: 'A sling has to hold a fixed shape when the pet moves, so the base panel and any internal frame are specified together with the fabric. A soft sling with no base support is the most common complaint in this format, and the cheapest thing to fix at the sample stage.',
  },
  {
    title: 'Hardware and safety tether',
    desc: 'Adjustable straps, buckles, D-rings and an internal tether clip that attaches to a collar or harness. The tether is the feature buyers ask about most, because a hands-free carrier that a pet can step out of is a return waiting to happen.',
  },
  {
    title: 'Colourways and retail packaging',
    desc: 'Stock models already run several colourways, so a private-label order can start from an existing colour and add branded hardware, labels and retail packaging. Zip bags and cartons are specified to your pack format.',
  },
];

const limits = [
  {
    title: 'A sling carries a small pet better than a large one',
    desc: 'The reference band in this sub-range runs from 5 kg to 9 kg, and the practical ceiling is lower than a backpack of the same weight guide, because the load sits on one strap. For a pet above roughly 8 kg, a backpack or a tote distributes the weight better than a sling does.',
  },
  {
    title: 'Pets that do not settle need a different format',
    desc: 'A hands-free carrier keeps the pet close, which helps an anxious pet, but a pet that will not stay still is better in a structured shell where it cannot move around. The carry format should follow the animal’s temperament, not just its weight.',
  },
  {
    title: 'Not every model appears in the comparison table with full figures',
    desc: 'A small number of models are confirmed on the sample rather than from a fixed spec sheet, and a couple are being re-confirmed with the factory. The product pages carry the current figures, and anything marked — is being checked rather than estimated.',
  },
  {
    title: 'Washability depends on the frame',
    desc: 'A sling with a moulded base or a wire frame cannot be washed whole — the panel has to be wiped, or the liner removed and washed on its own. If easy cleaning is a selling point in your market, ask for a removable liner at the sample stage. It is far cheaper to add then than to retrofit once the pattern is cut.',
  },
];

const faqs = [
  {
    q: 'What is a pet sling carrier?',
    a: 'A pet sling carrier is a hands-free bag worn across the body on a single strap, with the pet riding against the hip or chest. It is the most compact format in a carrier range and usually folds flat for shipping. It suits small cats and toy breeds; for pets above roughly 8 kg a backpack distributes the weight better.',
  },
  {
    q: 'Sling, backpack or tote — which should I stock?',
    a: 'Stock by the customer, not by the label. Slings and crossbody bags suit cat owners and small-breed buyers who want a discreet everyday carrier. Front chest carriers suit owners of anxious pets. Totes carry the heaviest pets and double as general carry bags. Most distributors carry all three and let the product photography drive the choice.',
  },
  {
    q: 'How do I size a sling carrier for a pet?',
    a: 'For this format, weight is less useful than body length and whether the pet can sit fully inside the pocket. The reference band runs 5 kg to 9 kg, but a long-backed animal needs a deeper pocket than the weight guide alone suggests. If you can share the pet’s length and weight we will match the model.',
  },
  {
    q: 'Are these carriers suitable for cats?',
    a: 'Yes — the crossbody and sling models are among the most common cat carriers, because a cat that is held close tends to settle better than in a large open bag, and the tether clip keeps it secure. A model with mesh on several faces and a top opening is usually the easiest for a cat owner to use one-handed.',
  },
  {
    q: 'Can a sling carrier be used on a bicycle?',
    a: 'A standard sling is not designed for cycling, because the strap can shift under the movement of the ride. The Safe Cycling Pet Front Bag in this range is the model built for it, with a fixed chest position and a wider support base. For any other model, we would not recommend riding with it.',
  },
  {
    q: 'What is the minimum order quantity?',
    a: `Trial orders on stock designs start at ${MOQ_TIERS[0].qty}. A custom strap geometry, a new material or a bespoke colourway needs its own sampling round and carries a higher minimum, with the exact figure following the specification. Volume pricing applies as quantities step up.`,
  },
  {
    q: 'Can sling carriers be private-labelled?',
    a: 'Yes. Woven and printed labels, custom colourways, branded hardware, logo patches and retail packaging are all part of the OEM programme. Stock models already run multiple colourways, so many private-label orders start from an existing colour and add only your branding.',
  },
];

const relatedLinks = [
  { href: '/collections/pet-carrier-bags/', label: 'All carrier bags & backpacks' },
  { href: '/airline-approved-pet-carriers/', label: 'Airline cabin carriers' },
  { href: '/pet-backpack-carriers/', label: 'Pet backpack carriers' },
  { href: '/wholesale/', label: 'Wholesale programme' },
  { href: '/oem-odm/', label: 'OEM / ODM & private label' },
];
---

<Layout
  title="Pet Sling Carrier Manufacturer — Wholesale & OEM"
  description="Pet sling and crossbody carrier manufacturer with 16 hands-free models across four carry styles — front chest, sling, crossbody, shoulder and tote. For pets from 5 kg to 9 kg, in nylon, 600D Oxford and breathable mesh. OEM, private label and trial orders from 10 pcs."
>
  <script type="application/ld+json" set:html={breadcrumbSchema} />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-olive-dark py-20 md:py-28">
    <div class="container-site relative z-10">
      <div class="max-w-3xl">
        <nav aria-label="Breadcrumb" class="text-xs text-cream/60">
          <a href="/" class="hover:text-cream">Home</a>
          <span class="mx-2">/</span>
          <a href="/collections/pet-carrier-bags/" class="hover:text-cream">Carrier Bags</a>
          <span class="mx-2">/</span>
          <span class="text-cream/90">Sling &amp; Crossbody Carriers</span>
        </nav>
        <span class="mt-4 block text-sm font-semibold uppercase tracking-[0.2em] text-cream/70">
          Sub-category · 16 hands-free models
        </span>
        <h1 class="mt-3 font-display text-4xl font-bold text-cream md:text-5xl">
          Pet sling, crossbody and front carriers for wholesale and OEM
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-cream/85">
          Pet sling, crossbody and front carriers are the hands-free end of a carrier range — the
          pet rides against the body on one strap rather than in a backpack or a tote. ONEPENUT
          builds 16 models across four carry styles, for pets from 5 kg to 9 kg, in nylon, 600D
          Oxford and breathable mesh.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={whatsappLink(waMsg)} target="_blank" rel="noopener noreferrer" class="btn-wa">
            Discuss a sling range
          </a>
          <a
            href="/quote"
            class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-cream/40 px-6 py-3 text-sm font-semibold text-cream transition-colors hover:bg-cream/10"
          >
            Request a quote
          </a>
        </div>
        <p class="mt-5 text-sm text-cream/70">
          16 models · four carry styles · reference specs confirmed on the approved sample
        </p>
      </div>
    </div>
  </section>

  <!-- 数字 -->
  <section class="container-site py-14 md:py-16">
    <div class="grid grid-cols-2 gap-5 md:grid-cols-4">
      {stats.map((s) => (
        <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 text-center shadow-card">
          <div class="font-display text-2xl font-bold text-olive-dark md:text-3xl">{s.num}</div>
          <div class="mt-2 text-sm text-stone">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 四种背负方式 -->
  <section class="container-site pb-16 md:pb-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold text-dark-brown md:text-4xl">
        One strap, four carry positions
      </h2>
      <p class="mt-3 leading-relaxed text-stone">
        &ldquo;Hands-free carrier&rdquo; covers four distinct formats, each specified to a
        different customer and a different load. Getting the format right matters more than the
        colourway.
      </p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {styles.map((m) => (
        <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
          <span class="inline-block rounded-full bg-olive/10 px-3 py-1 text-xs font-medium text-olive-dark">
            {m.tag}
          </span>
          <h3 class="mt-3 font-display text-lg font-bold text-dark-brown">{m.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone">{m.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 规格对照表 -->
  <section class="border-y border-milk-tea/60 bg-white/50">
    <div class="container-site py-14 md:py-20">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold text-dark-brown md:text-4xl">
          The hands-free range at a glance
        </h2>
        <p class="mt-3 leading-relaxed text-stone">
          All 16 models, grouped by carry style. Sizes are reference values and are confirmed on the
          approved sample. Net weights marked &mdash; are being re-confirmed with the factory rather
          than estimated.
        </p>
      </div>

      <div class="mt-10 overflow-x-auto rounded-3xl border border-milk-tea/60 bg-white shadow-card">
        <table class="w-full text-left text-sm">
          <thead class="bg-cream text-xs uppercase tracking-wide text-stone">
            <tr>
              <th class="px-5 py-4 font-semibold">Model</th>
              <th class="px-5 py-4 font-semibold">Carry style</th>
              <th class="px-5 py-4 font-semibold">Size</th>
              <th class="px-5 py-4 font-semibold">Pet up to</th>
              <th class="px-5 py-4 font-semibold">Shell</th>
              <th class="px-5 py-4 font-semibold">Net weight</th>
            </tr>
          </thead>
          <tbody>
            {slingTable.map((r) => (
              <tr class="border-t border-milk-tea/50 align-top">
                <td class="px-5 py-4">
                  <a
                    href={`/products/${r.slug}/`}
                    class="font-semibold text-olive-dark underline underline-offset-2 hover:text-caramel-dark"
                  >
                    {r.model}
                  </a>
                </td>
                <td class="px-5 py-4 leading-relaxed text-stone">{r.style}</td>
                <td class="px-5 py-4 leading-relaxed text-stone">{r.size}</td>
                <td class="px-5 py-4 leading-relaxed text-stone">{r.pet}</td>
                <td class="px-5 py-4 leading-relaxed text-stone">{r.shell}</td>
                <td class="px-5 py-4 leading-relaxed text-stone">{r.net}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 产品栅格 -->
  <section class="container-site py-14 md:py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold text-dark-brown md:text-4xl">
        Every model in the range
      </h2>
      <p class="mt-3 leading-relaxed text-stone">
        Open any model for its full specification, sizing and packing detail.
      </p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => (
        <ProductCard product={p} />
      ))}
    </div>
  </section>

  <!-- 定制要点 -->
  <section class="border-y border-milk-tea/60 bg-cream/50">
    <div class="container-site py-14 md:py-20">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold text-dark-brown md:text-4xl">
          What to specify on a hands-free carrier
        </h2>
        <p class="mt-3 leading-relaxed text-stone">
          Six points that decide whether a sling sells as a considered carrier or comes back as a
          return. All six are open to your specification.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {specPoints.map((s) => (
          <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
            <h3 class="font-display text-base font-bold text-dark-brown">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 边界与口径 -->
  <section class="container-site py-14 md:py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold text-dark-brown md:text-4xl">
        What to check before you buy
      </h2>
      <p class="mt-3 leading-relaxed text-stone">
        Four limits, stated up front — cheaper to settle now than after the listing is live.
      </p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {limits.map((l) => (
        <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
          <h3 class="font-display text-base font-bold text-dark-brown">{l.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone">{l.desc}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 rounded-2xl border border-milk-tea/60 bg-white/70 p-5 text-xs leading-relaxed text-stone">
      <span class="font-semibold text-dark-brown">Please note: </span>
      this page is a product range guide, not veterinary or legal advice. Whether a product may be
      sold in your market with a particular claim is a question for your own regulatory advisor —
      tell us what they require and we will build to it.
    </p>
  </section>

  <!-- 相关主题 -->
  <section class="border-y border-milk-tea/60 bg-white/50">
    <div class="container-site py-12 md:py-16">
      <h2 class="font-display text-2xl font-bold text-dark-brown md:text-3xl">
        Continue through this range
      </h2>
      <div class="mt-6 flex flex-wrap gap-3">
        {relatedLinks.map((l) => (
          <a
            href={l.href}
            class="rounded-full border border-milk-tea bg-cream px-4 py-2 text-sm font-medium text-stone transition-colors hover:border-olive hover:text-olive-dark"
          >
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-site py-14 md:py-20">
    <FaqList
      items={faqs}
      intro="The seven questions buyers ask most often about sling and crossbody pet carriers, answered the same way we would answer them on a call."
    />
  </section>

  <CtaBand
    title="Tell us the carry position and we will build the strap to it"
    desc="Send the pet weight and body length, the carry position you want, the material you have in mind and your destination market. If you are unsure which of the 16 fits, send the closest one you sell today and we will work from there."
    waMsg={waMsg}
  />
</Layout>
