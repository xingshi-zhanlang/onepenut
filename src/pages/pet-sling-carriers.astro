---
// 宠物斜挎 / 前抱 / 肩背 —— 子类落地页（collections/pet-carrier-bags 之下）
// 定位：承接 pet sling carrier / hands-free pet carrier / crossbody pet carrier 采购词
//
// ⚠️ 口径纪律（改动前必读）：
//   1. 本页只收录「宠物坐进去」的免提包。类目里的 bobo-crossbody-travel-bag 与
//      pet-crossbody-small-bag 实为主人随身收纳包（装手机/零食/拾便袋），不属 carrier，已排除。
//   2. pet-walking-shoulder-bag 的净重/毛重数据自相矛盾（净重 > 毛重），表格中暂标 — 待工厂核实。
//   3. 规格均为 reference values，以 approved sample 为准；交易数字只从 src/data/trade.ts 取。
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { SITE, whatsappLink } from '../consts';
import { MOQ_TIERS } from '../data/trade';

const waMsg =
  'Hello ONEPENUT, I am sourcing pet sling and crossbody carriers and would like a quote.';

const allProducts = await getCollection('products');
const SLUGS = [
  'pet-front-carrier-chest-bag',
  'mountain-style-pet-chest-bag',
  'soft-fufu-pet-chest-bag',
  'safe-cycling-pet-front-bag',
  'pet-sling-backpack',
  'soft-fufu-pet-crossbody-bag',
  'pet-travel-crossbody-bag',
  'breathable-mesh-pet-bag',
  'color-block-pet-shoulder-bag',
  'nylon-pet-shoulder-bag',
  'pet-walking-shoulder-bag',
  'baguette-pet-shoulder-bag',
  'mountain-style-pet-tote-bag',
  'pet-single-shoulder-tote-bag',
  'pet-travel-tote-bag',
  'checkered-horizontal-pet-bag',
];
const products = allProducts.filter((p) => SLUGS.includes(p.slug));

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Carrier Bags & Backpacks',
      item: `${SITE.url}/collections/pet-carrier-bags/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Pet Sling & Crossbody Carriers',
      item: `${SITE.url}/pet-sling-carriers/`,
    },
  ],
});

const stats = [
  { num: '16', label: 'Hands-free carriers in this sub-range' },
  { num: '4', label: 'Carry styles: chest, sling, shoulder, tote' },
  { num: '5–9 kg', label: 'Reference pet weight band' },
  { num: '340 g', label: 'Lightest model, net weight' },
];

const styles = [
  {
    title: 'Front chest carrier',
    desc: 'The pet rides against your chest, held by two straps that cross at the back. This is the most secure hands-free position and the one owners of anxious or clingy pets ask for, because the animal stays in physical contact and can be watched without looking away from where you are walking.',
    tag: 'Closest to the body',
  },
  {
    title: 'Crossbody and sling',
    desc: 'A single strap crosses the body and the bag rests at the hip or the chest, so one hand stays free and the carrier can be swung to the front. Slings suit small cats and toy breeds and are the most compact format to ship, because most models fold flat into a zip bag.',
    tag: 'Most compact',
  },
  {
    title: 'Shoulder bag',
    desc: 'A structured bag carried on one shoulder, usually with a top opening the pet can be placed into and mesh panels for airflow. It reads as an everyday handbag rather than a pet product, which is why it sells well into fashion-led pet boutiques and gift retail.',
    tag: 'Retail-led',
  },
  {
    title: 'Tote and carry bag',
    desc: 'The largest hands-free format, with handles plus an optional shoulder strap and a wider floor area. Totes carry the heaviest pets in this sub-range and double as a general carry bag, which makes them the natural bridge between this sub-category and the airline cabin carriers.',
    tag: 'Largest capacity',
  },
];

const slingTable = [
