---
// 关于页
import Layout from '../layouts/Layout.astro';
import { ADVANTAGES, CONTACT, whatsappLink } from '../consts';
const msg =
  'Hello ONEPENUT, I would like to learn more about your company and products.';
const link = whatsappLink(msg);
---

<Layout title="About Us - Premium Pet Travel Products Manufacturer" description="Learn about ONEPENUT, a pet carrier and harness manufacturer with OEM / ODM service for global brands and retailers.">
  <!-- 页头 -->
  <section class="container-site py-12 md:py-16">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">About Us</span>
      <h1 class="mt-3 font-display text-4xl font-bold text-dark-brown md:text-5xl">
        Making pet travel comfortable and safe
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-stone">
        ONEPENUT is a manufacturer of premium pet travel products — carriers,
        harnesses and travel essentials designed for cats and dogs. We serve
        global retailers, brands and distributors with quality products and
        reliable OEM / ODM service.
      </p>
    </div>
  </section>

  <!-- 品牌理念 -->
  <section class="bg-white/50 py-16 md:py-20">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="order-2 lg:order-1">
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">Our Story</span>
        <h2 class="mt-3 font-display text-3xl font-bold text-dark-brown">
          Designed around your pet
        </h2>
        <p class="mt-5 leading-relaxed text-stone">
          We started with a simple belief: travel should be a joy, not a
          struggle, for pets and their humans. Every ONEPENUT product is
          researched, prototyped and tested with real pets in mind.
        </p>
        <p class="mt-3 leading-relaxed text-stone">
          From the materials we choose to the way each seam is sewn, we focus
          on comfort, safety and durability. Our eco-friendly approach uses
          RPET recycled fabrics and sustainable construction wherever possible.
        </p>

        <div class="mt-8 grid grid-cols-3 gap-4">
          <div class="rounded-2xl border border-milk-tea/60 bg-white p-4 text-center">
            <p class="font-display text-2xl font-bold text-olive-dark">5+</p>
            <p class="mt-1 text-xs text-stone">Product Lines</p>
          </div>
          <div class="rounded-2xl border border-milk-tea/60 bg-white p-4 text-center">
            <p class="font-display text-2xl font-bold text-olive-dark">100+</p>
            <p class="mt-1 text-xs text-stone">SKUs</p>
          </div>
          <div class="rounded-2xl border border-milk-tea/60 bg-white p-4 text-center">
            <p class="font-display text-2xl font-bold text-olive-dark">OEM</p>
            <p class="mt-1 text-xs text-stone">Custom Service</p>
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <div class="overflow-hidden rounded-[2rem] border border-milk-tea/60 shadow-card">
          <img
            src="/images/about-sample-room.webp"
            alt="ONEPENUT sample room — a pet carrier prototype on the worktable beside fabric swatches, measuring tape and pattern tools"
            width="1200"
            height="712"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 优势 -->
  <section class="container-site py-16 md:py-20">
    <div class="text-center">
      <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">Why Choose Us</span>
      <h2 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl">
        What we bring to your brand
      </h2>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {ADVANTAGES.map((a) => (
        <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-olive/10 text-olive-dark">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={a.icon}></path>
            </svg>
          </div>
          <h3 class="mt-4 font-display text-lg font-bold text-dark-brown">{a.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone">{a.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container-site pb-16 md:pb-24">
    <div class="rounded-[2.5rem] border border-milk-tea/60 bg-white p-8 text-center shadow-card md:p-12">
      <h2 class="font-display text-2xl font-bold text-dark-brown md:text-3xl">
        Let's build your pet product line together
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-stone">
        Contact us for catalog, wholesale pricing and OEM / ODM support.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={link} target="_blank" rel="noopener noreferrer" class="btn-wa">
          Chat on WhatsApp
        </a>
        <a href={`mailto:${CONTACT.email}`} class="btn-caramel">Email Us</a>
      </div>
    </div>
  </section>
</Layout>
