---
// 联系页 - 主要通过 WhatsApp 询盘
import Layout from '../layouts/Layout.astro';
import { CONTACT, whatsappLink } from '../consts';

const msgs = {
  quote:
    'Hello ONEPENUT, I would like to request a quotation for your pet products.',
  catalog:
    'Hello ONEPENUT, please send me your product catalog and wholesale price list.',
  oem:
    'Hello ONEPENUT, I am interested in your OEM / ODM services. Can we discuss?',
  sample:
    'Hello ONEPENUT, I would like to request samples. Please advise the process.',
  general:
    'Hello ONEPENUT, I have a question about your products.',
};

const quickLinks = [
  { label: 'Request a Quote', msg: msgs.quote, icon: 'M9 12l2 2 4-4M21 12c0 5-3.5 7.5-8.5 9.5C7.5 19.5 4 17 4 12V6l8.5-3.5L21 6v6z' },
  { label: 'Get Catalog & Pricing', msg: msgs.catalog, icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
  { label: 'OEM / ODM Inquiry', msg: msgs.oem, icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z' },
  { label: 'Request Samples', msg: msgs.sample, icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
];
---

<Layout title="Contact Us - Wholesale & OEM Inquiries" description="Contact ONEPENUT for wholesale pricing, OEM / ODM pet product manufacturing and sample requests. Fast response on WhatsApp.">
  <!-- 页头 -->
  <section class="container-site py-12 md:py-16">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">Contact</span>
      <h1 class="mt-3 font-display text-4xl font-bold text-dark-brown md:text-5xl">
        Let's talk about your project
      </h1>
      <p class="mt-5 text-lg text-stone">
        Reach us directly on WhatsApp for fast responses. We're happy to help
        with pricing, catalogs, samples and custom OEM / ODM projects.
      </p>
    </div>
  </section>

  <!-- 快捷询盘 -->
  <section class="container-site pb-8">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {quickLinks.map((q) => (
        <a
          href={whatsappLink(q.msg)}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-3xl border border-milk-tea/60 bg-white p-6 text-center shadow-card transition-all hover:-translate-y-1 hover:shadow-hover"
        >
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#25D366]/10 text-[#1fb959]">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={q.icon}></path>
            </svg>
          </div>
          <h3 class="mt-4 font-display text-lg font-bold text-dark-brown group-hover:text-olive-dark">
            {q.label}
          </h3>
          <span class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-[#1fb959]">
            Open WhatsApp
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17L17 7M7 7h10v10"></path>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 联系信息 -->
  <section class="container-site pb-16 md:pb-24">
    <div class="grid gap-8 md:grid-cols-2">
      <!-- 主要联系方式 -->
      <div class="rounded-3xl border border-milk-tea/60 bg-white p-8 shadow-card">
        <h2 class="font-display text-2xl font-bold text-dark-brown">Direct Contact</h2>
        <ul class="mt-6 space-y-5">
          <li>
            <a href={whatsappLink(msgs.general)} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 rounded-2xl border border-milk-tea/60 bg-cream/50 p-4 transition-colors hover:border-[#25D366]">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#25D366] text-white">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.973-1.041z"/>
                </svg>
              </span>
              <span>
                <span class="block text-xs text-stone">WhatsApp</span>
                <span class="block font-semibold text-dark-brown">{CONTACT.whatsappDisplay}</span>
              </span>
            </a>
          </li>
          <li>
            <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-4 rounded-2xl border border-milk-tea/60 bg-cream/50 p-4 transition-colors hover:border-olive">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-olive text-white">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </span>
              <span>
                <span class="block text-xs text-stone">Email</span>
                <span class="block font-semibold text-dark-brown">{CONTACT.email}</span>
              </span>
            </a>
          </li>
          <li class="flex items-center gap-4 rounded-2xl border border-milk-tea/60 bg-cream/50 p-4">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-caramel text-white">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </span>
            <span>
              <span class="block text-xs text-stone">Location</span>
              <span class="block font-semibold text-dark-brown">{CONTACT.address}</span>
            </span>
          </li>
        </ul>
      </div>

      <!-- 为什么联系 -->
      <div class="rounded-3xl bg-gradient-to-br from-olive to-olive-dark p-8 text-cream shadow-card md:p-10">
        <h2 class="font-display text-2xl font-bold">Why contact us?</h2>
        <ul class="mt-6 space-y-4">
          {[
            'Wholesale pricing for global retailers and distributors',
            'Full OEM / ODM service — design, materials, packaging and branding',
            'Samples and catalogs on request',
            'Reliable lead times and export documentation',
            'Fast response, typically within 24 hours',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12l2 2 4-4M21 12c0 5-3.5 7.5-8.5 9.5C7.5 19.5 4 17 4 12V6l8.5-3.5L21 6v6z"></path>
              </svg>
              <span class="text-cream/90">{item}</span>
            </li>
          ))}
        </ul>
        <a href={whatsappLink(msgs.general)} target="_blank" rel="noopener noreferrer" class="btn-wa mt-8 w-full justify-center text-base">
          Start a Conversation
        </a>
      </div>
    </div>
  </section>
</Layout>
