---
// MOQ、打样与交期页 —— 采购方搜 "pet carrier manufacturer MOQ" 的落地页
// 核心原则：数字直给、起算点写清、凡是我方不能承诺的地方明说「不包含」
import Layout from '../layouts/Layout.astro';
import TradeTerms from '../components/TradeTerms.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { whatsappLink } from '../consts';
import { COMMERCIAL, INDICATIVE, LEAD_TIME, MOQ_TIERS, SAMPLING } from '../data/trade';

const waMsg =
  'Hello ONEPENUT, I have a question about your MOQ and lead times. My order would be ____ pcs of ____ .';

// 首屏「短答案」：采购方只想要这几个数字
const shortAnswers = [
  { label: 'MOQ — stock designs', value: '10 pcs', note: 'Existing colours and sizes, mixed styles allowed' },
  { label: 'MOQ — with your logo', value: '100 pcs', note: 'Logo, hangtag and packaging on an existing design' },
  { label: 'MOQ — fully custom', value: '500 pcs', note: 'New pattern, custom materials, tooling or colour matching' },
  { label: 'Sample lead time', value: '5–15 days', note: `${SAMPLING.stockSampleLead} for stock, ${SAMPLING.customSampleLead} for custom` },
  { label: 'Bulk production', value: LEAD_TIME.production, note: 'From deposit AND approved sample, whichever is later' },
  { label: 'Payment', value: '30 / 70 T/T', note: 'L/C at sight for larger orders' },
];

// 交期包含 / 不包含
const includedInLeadTime = [
  'Material booking and in-house cutting',
  'Sewing, assembly and hardware attachment',
  'In-line and pre-shipment inspection',
  'Folding, labelling and carton packing',
];

const notIncludedInLeadTime = [
  'Sample development — that happens before the clock starts',
  'Fabric or hardware that has to be custom-made or imported (we tell you if your design needs it)',
  'Chinese New Year closure, which cannot be compressed',
  'Sea freight transit after the goods leave the port',
  'Time lost to artwork or packaging approval on your side',
];

const timeline = [
  { day: 'Day 0', label: 'Enquiry', detail: 'You send the product, quantity and destination.' },
  { day: 'Day 1', label: 'Quotation', detail: 'Unit price, MOQ, sample and production lead times, Incoterm — in writing.' },
  { day: 'Day 2–15', label: 'Sample', detail: `${SAMPLING.stockSampleLead} for a stock design, ${SAMPLING.customSampleLead} if it needs developing.` },
  { day: 'On approval', label: 'Deposit', detail: 'Production slot is booked once the deposit is received.' },
  { day: '+20–30', label: 'Production', detail: 'Bulk run, with in-line QC throughout.' },
  { day: 'Before loading', label: 'Inspection', detail: 'Random-sampling inspection and a photo report for your approval.' },
  { day: 'Then', label: 'Shipment', detail: 'Booking, loading and the full document set.' },
];

const faqs = [
  {
    q: 'Are these figures a commitment?',
    a: 'No, and it is worth being precise about that. They are the figures our lines run to today, which is not the same thing as a quotation. We would rather say so plainly than let you plan a launch around a number from a webpage. When your enquiry arrives we check your quantity and specification against the live production calendar, then confirm the MOQ, sample time and lead time in writing with your quotation. If a figure has to move, you hear it from us before you commit — not after the deposit is paid.',
  },
  {
    q: 'Is 10 pieces really your minimum order quantity?',
    a: 'Yes, for stock designs — products that already exist in our catalogue in their current colours and sizes. There is no tooling or pattern work involved, so a trial order that small costs us very little to run and it gets real goods into your hands before you commit to a container. It does not apply to custom products: if your design does not exist yet, the minimum is 500 pieces, because a production slot has to be set up specifically for it.',
  },
  {
    q: 'Can I mix colours or sizes inside one order to reach a quantity band?',
    a: 'Mixed sizes within one style are always fine. Mixing styles or colourways depends on whether they run on the same material and hardware — tell us the mix you want and we will confirm which parts of it can be combined into one tier.',
  },
  {
    q: 'How long does a sample take, and what does it cost?',
    a: `A stock sample takes ${SAMPLING.stockSampleLead}. A sample that needs developing takes ${SAMPLING.customSampleLead}. ${SAMPLING.sampleFee}`,
  },
  {
    q: 'How many revision rounds do I get on a custom sample?',
    a: `${SAMPLING.revisions} After that, further rounds are quoted at cost — which is why the brief matters more than the number of revisions. If the brief is complete, one round is usually enough.`,
  },
  {
    q: 'When exactly does the production clock start?',
    a: 'On the working day after two things have both happened: your deposit has been received, and you have approved the pre-production sample in writing. It is deliberately the later of the two. A supplier who counts from the order date is measuring something that has not started yet, and the number they give you will not hold.',
  },
  {
    q: 'Does the production lead time include shipping?',
    a: 'No. Bulk production is 20–30 days; sea freight transit is separate and depends entirely on the route. Ask us for a transit estimate to your port and we will give you one, but treat it as an estimate from the carrier rather than a promise from us.',
  },
  {
    q: 'What does the lead time not include?',
    a: 'Sample development, artwork or packaging approval time on your side, any material that has to be custom-made, the Chinese New Year closure, and sea freight. We list these separately rather than lumping them in, because a lead time that quietly assumes you will approve artwork in two days is not a lead time, it is a guess.',
  },
  {
    q: 'Can you rush an order?',
    a: `${LEAD_TIME.productionRush} Rush production depends on whether the fabric and hardware are in stock and whether there is a free line slot, so it has to be checked against the actual schedule rather than promised on the spot. Tell us your deadline and we will tell you honestly whether it is reachable.`,
  },
  {
    q: 'What happens if the goods are late?',
    a: 'We tell you as soon as we know, not on the shipping date. The two things you can do to protect yourself are to send final artwork with the deposit and to confirm the sample quickly — those two steps cause more delay than anything that happens on our lines.',
  },
  {
    q: 'Do you charge for samples and is it refundable?',
    a: `The sample is charged. ${SAMPLING.stockSampleFeeNote}`,
  },
];

const whyLowMoq = [
  {
    title: 'Stock designs need no setup',
    desc: 'The pattern, materials and hardware already exist and the design is already scheduled in our production calendar. Adding 10 pieces to a run costs us material and labour, not a tooling investment.',
  },
  {
    title: 'We would rather prove it than pitch it',
    desc: 'A buyer who has held the product in their hands orders with confidence, and every long-term customer we have started with a small order.',
  },
  {
    title: 'It is capped by design, not by goodwill',
    desc: 'The trial price exists to get goods to you, not to be the cheapest unit cost we can offer. Once your volume grows, the volume bands are where the margin is — for both of us.',
  },
];

const limits = [
  'Custom colours, materials or hardware are not available at trial quantities.',
  'Trial orders are limited to products already in the catalogue in their standard colourways.',
  'Custom packaging and printed hangtags start at the logo tier (100 pcs) or above.',
  'Trial orders are quoted at unit price plus courier — they are not a volume price.',
];
---

<Layout
  title="MOQ, Sampling & Lead Times — Pet Product Manufacturing"
  description="Our minimum order quantity is 10 pcs on stock designs, 100 pcs with your logo and 500 pcs for fully custom products. Sample lead time 5–15 days, bulk production 20–30 days. Full terms, with the day the clock starts."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-olive-dark py-20 md:py-28">
    <div class="container-site relative z-10">
      <div class="max-w-3xl">
        <nav aria-label="Breadcrumb" class="text-xs text-cream/60">
          <a href="/" class="hover:text-cream">Home</a>
          <span class="mx-2">/</span>
          <span class="text-cream/90">MOQ &amp; Sampling</span>
        </nav>
        <span class="mt-4 block text-sm font-semibold uppercase tracking-[0.2em] text-cream/70">
          Order Terms
        </span>
        <h1 class="mt-3 font-display text-4xl font-bold text-cream md:text-5xl">
          MOQ, sampling and lead times — the numbers, not a vague reply
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-cream/85">
          Most suppliers answer "MOQ?" with "it depends". Here are the figures we run to,
          including when the production clock starts and what it does not cover. Yours are
          confirmed in writing when you enquire.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={whatsappLink(waMsg)} target="_blank" rel="noopener noreferrer" class="btn-wa">
            Ask about your specific order
          </a>
          <a
            href="/quote"
            class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-cream/40 px-6 py-3 text-sm font-semibold text-cream transition-colors hover:bg-cream/10"
          >
            Request a quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 短答案 -->
  <section class="container-site -mt-8 md:-mt-10">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {shortAnswers.map((a) => (
        <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
          <div class="text-xs font-semibold uppercase tracking-[0.12em] text-stone">{a.label}</div>
          <div class="mt-2 font-display text-2xl font-bold text-caramel-dark">{a.value}</div>
          <div class="mt-2 text-sm leading-relaxed text-stone">{a.note}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 典型值说明 —— 主动讲清「页面数字 vs 报价单数字」，不藏进免责声明 -->
  <section class="container-site pt-12 md:pt-14">
    <div class="rounded-3xl border border-caramel/30 bg-caramel/5 p-6 md:p-8">
      <h2 class="font-display text-2xl font-bold text-dark-brown">
        The figures are typical — your quotation is what counts
      </h2>
      <p class="mt-3 leading-relaxed text-stone">{INDICATIVE.body}</p>
      <div class="mt-7 grid gap-7 md:grid-cols-2">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.12em] text-caramel-dark">
            Checked against the schedule when you order
          </h3>
          <ul class="mt-3 space-y-2.5">
            {INDICATIVE.whatChanges.map((i) => (
              <li class="flex gap-3 text-sm leading-relaxed text-stone">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-caramel"></span>
                <span>{i}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.12em] text-olive-dark">
            What stays the same regardless
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-stone">{INDICATIVE.whatDoesNot}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MOQ 表 -->
  <section class="container-site py-14 md:py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold text-dark-brown md:text-4xl">
        Minimum order quantity, by order type
      </h2>
      <p class="mt-3 leading-relaxed text-stone">
        There is one MOQ number for stock designs, a higher one once your branding is
        added, and a higher one again when the product has to be developed. The reason
        is setup work, not order value.
      </p>
    </div>
    <div class="mt-10">
      <TradeTerms />
    </div>
  </section>

  <!-- 为什么可以低, 以及低在哪不适用 -->
  <section class="border-y border-milk-tea/60 bg-white/50">
    <div class="container-site py-14 md:py-20">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-bold text-dark-brown md:text-4xl">
            Why a 10-piece MOQ is possible
          </h2>
          <div class="mt-6 space-y-5">
            {whyLowMoq.map((w) => (
              <div>
                <h3 class="font-display text-lg font-bold text-dark-brown">{w.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-stone">{w.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-3xl border border-caramel/30 bg-caramel/5 p-6 md:p-8">
          <h2 class="font-display text-2xl font-bold text-dark-brown">
            Where the low MOQ does not apply
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-stone">
            We would rather set this out now than surprise you at quotation stage.
          </p>
          <ul class="mt-5 space-y-3">
            {limits.map((l) => (
              <li class="flex gap-3 text-sm leading-relaxed text-stone">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-caramel"></span>
                <span>{l}</span>
              </li>
            ))}
          </ul>
          <p class="mt-5 text-sm leading-relaxed text-stone">
            Not sure which tier your enquiry falls into? Send it as it is and we will
            tell you where it lands.
          </p>
          <a href={whatsappLink(waMsg)} target="_blank" rel="noopener noreferrer" class="btn-caramel mt-5">
            Ask where my order lands
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 打样 -->
  <section class="container-site py-14 md:py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold text-dark-brown md:text-4xl">
        Sampling: what we send, how long it takes, what it costs
      </h2>
      <p class="mt-3 leading-relaxed text-stone">
        You approve a physical sample, not a render. Nothing goes into bulk production
        until you have signed off on the object itself.
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
        <h3 class="font-display text-lg font-bold text-dark-brown">Stock sample</h3>
        <p class="mt-1 font-display text-xl font-bold text-caramel-dark">{SAMPLING.stockSampleLead}</p>
        <p class="mt-3 text-sm leading-relaxed text-stone">
          An existing catalogue product in its standard colourway, shipped by courier.
          Use it to check material, hardware and workmanship before deciding on
          anything else.
        </p>
      </div>
      <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
        <h3 class="font-display text-lg font-bold text-dark-brown">Custom sample</h3>
        <p class="mt-1 font-display text-xl font-bold text-caramel-dark">{SAMPLING.customSampleLead}</p>
        <p class="mt-3 text-sm leading-relaxed text-stone">
          Built to your brief: your pattern, your colours, your logo, your hardware.
          This is the sample that goes into a bulk order once approved.
        </p>
      </div>
      <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
        <h3 class="font-display text-lg font-bold text-dark-brown">Sample charge</h3>
        <p class="mt-1 font-display text-xl font-bold text-caramel-dark">Quoted per project</p>
        <p class="mt-3 text-sm leading-relaxed text-stone">{SAMPLING.sampleFee}</p>
      </div>
    </div>

    <div class="mt-8 rounded-3xl border border-olive/30 bg-olive/5 p-6 md:p-8">
      <h3 class="font-display text-xl font-bold text-dark-brown">
        What we need from you before a custom sample can start
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-stone">
        This list is the difference between one sample round and four.
      </p>
      <ul class="mt-5 grid gap-3 md:grid-cols-2">
        {SAMPLING.requiredFromBuyer.map((r) => (
          <li class="flex gap-3 text-sm leading-relaxed text-stone">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-olive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6L9 17l-5-5"></path>
            </svg>
            <span>{r}</span>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-sm leading-relaxed text-dark-brown">
        <span class="font-semibold">Revision rounds: </span>
        <span class="text-stone">{SAMPLING.revisions}</span>
      </p>
    </div>
  </section>

  <!-- 交期 -->
  <section class="border-y border-milk-tea/60 bg-cream/60">
    <div class="container-site py-14 md:py-20">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold text-dark-brown md:text-4xl">
          Production lead time, and where it starts
        </h2>
        <p class="mt-3 leading-relaxed text-stone">{LEAD_TIME.productionNote}</p>
      </div>

      <!-- 时间线 -->
      <ol class="mt-10 grid gap-4 md:grid-cols-4 lg:grid-cols-7">
        {timeline.map((t) => (
          <li class="rounded-3xl border border-milk-tea/60 bg-white p-5 shadow-card">
            <span class="text-xs font-semibold uppercase tracking-[0.12em] text-caramel-dark">{t.day}</span>
            <h3 class="mt-1.5 font-display text-base font-bold text-dark-brown">{t.label}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone">{t.detail}</p>
          </li>
        ))}
      </ol>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <div class="rounded-3xl border border-olive/30 bg-white p-6 shadow-card md:p-8">
          <h3 class="font-display text-lg font-bold text-dark-brown">What the lead time covers</h3>
          <ul class="mt-4 space-y-2.5">
            {includedInLeadTime.map((i) => (
              <li class="flex gap-3 text-sm leading-relaxed text-stone">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-olive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6L9 17l-5-5"></path>
                </svg>
                <span>{i}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-3xl border border-caramel/30 bg-white p-6 shadow-card md:p-8">
          <h3 class="font-display text-lg font-bold text-dark-brown">What it does not cover</h3>
          <ul class="mt-4 space-y-2.5">
            {notIncludedInLeadTime.map((i) => (
              <li class="flex gap-3 text-sm leading-relaxed text-stone">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-caramel"></span>
                <span>{i}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 延误源 -->
  <section class="container-site py-14 md:py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold text-dark-brown md:text-4xl">
        The four things that actually delay an order
      </h2>
      <p class="mt-3 leading-relaxed text-stone">
        None of them are production. All four are predictable, and all four are
        avoidable if you plan around them.
      </p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {LEAD_TIME.delayRisks.map((d) => (
        <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
          <h3 class="font-display text-lg font-bold text-dark-brown">{d.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone">{d.detail}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card md:p-8">
      <h3 class="font-display text-lg font-bold text-dark-brown">Rush orders</h3>
      <p class="mt-2 text-sm leading-relaxed text-stone">
        {LEAD_TIME.productionRush} Because it depends on material stock and free line
        capacity, we check it against the real schedule rather than promising it on the
        spot. Give us your deadline in-store date and we will tell you whether it is
        reachable before you commit.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-stone">
        <span class="font-semibold text-dark-brown">Payment terms: </span>
        {COMMERCIAL.payment} {COMMERCIAL.paymentSmall}
      </p>
    </div>
  </section>

  <FaqList
    items={faqs}
    intro="The questions buyers ask about quantities and timing, answered with figures rather than with the answer 'it depends'."
  />

  <CtaBand
    title="Tell us the quantity and the deadline"
    desc="We will tell you which tier it falls into, what the sample will take, and whether your in-store date is realistic. If it is not, we will say so before you commit rather than after."
    waMsg="Hello ONEPENUT, I would like to confirm MOQ and lead time for my order."
  />
</Layout>
