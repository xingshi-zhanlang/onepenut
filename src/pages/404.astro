---
import Layout from '../layouts/Layout.astro';
const popular = [
  { href: '/products/', label: 'View the full catalog' },
  { href: '/factory/', label: 'Factory & OEM capabilities' },
  { href: '/about/', label: 'About ONEPENUT' },
  { href: '/contact/', label: 'Contact / request a quote' },
];
---

<Layout title="Page Not Found" robots="noindex, follow">
  <section class="container-site py-20 text-center md:py-28">
    <p class="font-display text-7xl font-bold text-olive/30 md:text-8xl">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-dark-brown md:text-4xl">
      Page not found
    </h1>
    <p class="mx-auto mt-4 max-w-md text-stone">
      The page you're looking for doesn't exist or has moved. Try one of these:
    </p>
    <div class="mt-8 flex flex-col items-center gap-3">
      {popular.map((p) => (
        <a
          href={p.href}
          class="rounded-full border border-milk-tea bg-white px-5 py-2.5 text-sm font-medium text-dark-brown transition-colors hover:border-olive hover:text-olive-dark"
        >
          {p.label}
        </a>
      ))}
    </div>
  </section>
</Layout>
