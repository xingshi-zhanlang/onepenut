---
// 产品列表页（支持分类过滤）
import Layout from '../../layouts/Layout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, getCategory } from '../../consts';

const allProducts = await getCollection('products');
const activeCategory = Astro.url.searchParams.get('category') || 'all';

const products =
  activeCategory === 'all'
    ? allProducts
    : allProducts.filter((p) => p.data.category === activeCategory);
---

<Layout title="Pet Carriers, Harnesses & Travel Essentials" description="Explore ONEPENUT premium pet carriers, dog harnesses, cat harnesses and travel essentials for wholesale, OEM and ODM.">
  <!-- 页头 -->
  <section class="container-site py-12 md:py-16">
    <div class="text-center">
      <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">Catalog</span>
      <h1 class="mt-3 font-display text-4xl font-bold text-dark-brown md:text-5xl">
        Our Products
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-stone">
        Premium pet carriers, harnesses and travel essentials. Available for
        wholesale, OEM and ODM.
      </p>
    </div>

    <!-- 分类过滤 -->
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      <a
        href="/products"
        class={`rounded-full px-4 py-2 text-sm font-medium transition-colors ${
          activeCategory === 'all'
            ? 'bg-olive text-cream'
            : 'border border-milk-tea bg-white text-stone hover:border-olive hover:text-olive-dark'
        }`}
      >
        All
      </a>
      {CATEGORIES.map((c) => (
        <a
          href={`/products?category=${c.slug}`}
          class={`rounded-full px-4 py-2 text-sm font-medium transition-colors ${
            activeCategory === c.slug
              ? 'bg-olive text-cream'
              : 'border border-milk-tea bg-white text-stone hover:border-olive hover:text-olive-dark'
          }`}
        >
          {c.name}
        </a>
      ))}
    </div>
  </section>

  <!-- 产品网格 -->
  <section class="container-site pb-16 md:pb-24">
    {products.length > 0 ? (
      <ProductGrid products={products} />
    ) : (
      <div class="py-20 text-center">
        <p class="text-lg font-medium text-dark-brown">No products in this category yet.</p>
        <p class="mt-2 text-sm text-stone">
          Check back soon, or contact us to learn about available lines.
        </p>
      </div>
    )}
  </section>
</Layout>
