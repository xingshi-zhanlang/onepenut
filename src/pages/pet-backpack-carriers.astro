---
// 宠物背包 —— 子类落地页（collections/pet-carrier-bags 之下）
// 定位：承接 pet backpack carrier / dog backpack carrier / cat backpack wholesale 采购词
//
// ⚠️ 合规纪律（改动前必读）：
//   1. 不得宣称本厂或产品持有任何第三方认证；规格均为 reference values，以 approved sample 为准。
//   2. spine-protect 系两款为「穿戴式」结构（规格按胸围/腿围），不是装桶式背包 ——
//      页面必须把两种结构分开讲，否则采购方会买错。
//   3. 交易数字只从 src/data/trade.ts 取，不在此硬编码。
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { SITE, whatsappLink } from '../consts';
import { MOQ_TIERS } from '../data/trade';

const waMsg =
  'Hello ONEPENUT, I am sourcing pet backpack carriers and would like a quote.';

const allProducts = await getCollection('products');
const SLUGS = [
  'first-class-cat-backpack',
  'baguette-pet-backpack-carrier',
  'mobile-castle-ultra-light-pet-backpack',
  'free-spirit-pet-backpack',
  'front-hugging-pet-tote-backpack',
  'lightweight-pet-backpack',
  'pet-sling-backpack',
  'spine-protect-pet-backpack',
  'spine-support-cooling-pet-backpack',
  'tent-pet-backpack',
  'first-class-tent-pet-backpack',
  'front-tent-pet-backpack',
  'weekend-pet-tent-backpack',
];
const products = allProducts.filter((p) => SLUGS.includes(p.slug));

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Carrier Bags & Backpacks',
      item: `${SITE.url}/collections/pet-carrier-bags/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Pet Backpack Carriers',
      item: `${SITE.url}/pet-backpack-carriers/`,
    },
  ],
});

const stats = [
  { num: '13', label: 'Backpack models in this sub-range' },
  { num: '2', label: 'Structures: carry-inside & wearable' },
  { num: '35–56 cm', label: 'Closed length range' },
  { num: 'up to 15 kg', label: 'Largest pet weight guide' },
];

const structures = [
  {
    title: 'Carry-inside shell',
    desc: 'A rigid or semi-rigid shell the pet sits in, with mesh windows on the front and sides, worn on your back. This is the structure most buyers picture when they search for a pet backpack. It suits cats and small dogs that settle in a confined space, and it is the format that takes a bubble window, a removable liner and a structured base board most easily.',
    tag: 'Most searched',
  },
  {
    title: 'Wearable harness-backpack',
    desc: 'The pet wears a harness built into the pack, and the pack carries the pet against the chest or the back with the animal’s legs supported rather than tucked. Specifications for this structure are quoted by chest girth and leg span rather than an interior length, because the fit is on the animal, not inside a box. It is the usual pick for owners who want to carry a heavier pet and keep its posture supported.',
    tag: 'Fit by girth',
  },
  {
    title: 'Zip-out tent',
    desc: 'A carry-inside backpack with a second section that unzips to roughly double the floor area — the pet travels in the closed footprint and has a small enclosure to rest in once you arrive. Two measurements matter here: the closed size for travel and the expanded size for use at the destination. We publish both so they are not confused.',
    tag: 'Two footprints',
  },
  {
    title: 'Soft tote-backpack',
    desc: 'A fabric tote with dual straps so it can be carried on the back or by the handle. Lighter than a hard shell and cheaper to ship, but with less structure, so it suits small cats and toy breeds rather than larger animals. It is the entry price point in a backpack range and the model most buyers test the market with.',
    tag: 'Entry price',
  },
];

const backpackTable = [
