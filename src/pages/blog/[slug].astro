---
// 博客文章页 /blog/<slug>/
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { SITE, whatsappLink } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { title, description, publishDate, updatedDate, author, image, seoTitle, seoDescription, keywords } =
  post.data;

const { Content } = await render(post);
const pageUrl = new URL(`/blog/${post.slug}/`, SITE.url).href;

// 阅读时长（按 200 词/分钟估算）
const wordCount = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// 相关文章：同站其他指南（按发布时间取最新 3 篇，排除当前）
const related = posts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const inquiryMsg = `Hello ONEPENUT, I read your guide "${title}" and have a sourcing question.`;
const inquiryLink = whatsappLink(inquiryMsg);

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: image ? new URL(image, SITE.url).href : undefined,
      datePublished: publishDate.toISOString(),
      dateModified: (updatedDate || publishDate).toISOString(),
      author: { '@type': 'Organization', name: author },
      publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
      keywords: keywords?.join(', '),
      wordCount,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/blog/` },
        { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
      ],
    },
  ],
});
---

<Layout
  title={seoTitle || title}
  description={seoDescription || description}
  image={image}
  type="article"
>
  <script type="application/ld+json" set:html={schema}></script>

  <!-- 面包屑 -->
  <div class="container-site pt-8">
    <nav class="flex flex-wrap items-center gap-2 text-sm text-stone" aria-label="Breadcrumb">
      <a href="/" class="hover:text-olive-dark">Home</a>
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
      <a href="/blog/" class="hover:text-olive-dark">Guides</a>
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
      <span class="text-dark-brown">{title}</span>
    </nav>
  </div>

  <article class="container-site py-10 md:py-14">
    <header class="mx-auto max-w-3xl">
      <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">Guide</span>
      <h1 class="mt-3 font-display text-3xl font-bold leading-tight text-dark-brown md:text-4xl">
        {title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-stone">{description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-milk-tea/60 pt-5 text-sm text-stone">
        <span>{author}</span>
        <span class="h-1 w-1 rounded-full bg-milk-tea"></span>
        <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
        <span class="h-1 w-1 rounded-full bg-milk-tea"></span>
        <span>{readMinutes} min read</span>
        {updatedDate && (
          <>
            <span class="h-1 w-1 rounded-full bg-milk-tea"></span>
            <span>Updated {formatDate(updatedDate)}</span>
          </>
        )}
      </div>
    </header>

    <div class="mx-auto mt-10 max-w-3xl">
      <div class="prose-article">
        <Content />
      </div>
    </div>

    <!-- 询盘 CTA -->
    <div class="mx-auto mt-12 max-w-3xl rounded-3xl border border-milk-tea/60 bg-white p-7 shadow-card">
      <h2 class="font-display text-xl font-bold text-dark-brown">
        Need an answer specific to your product?
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-stone">
        Send us the model, your target market and your timeline. We will come
        back with concrete numbers instead of general guidance.
      </p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a href="/quote" class="btn-caramel">Request a Quote</a>
        <a href={inquiryLink} target="_blank" rel="noopener noreferrer" class="btn-wa">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.973-1.041z"/>
          </svg>
          Ask on WhatsApp
        </a>
      </div>
    </div>

    {related.length > 0 && (
      <section class="mx-auto mt-14 max-w-5xl">
        <h2 class="font-display text-2xl font-bold text-dark-brown">More sourcing guides</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {related.map((p) => (
            <a
              href={`/blog/${p.slug}/`}
              class="group flex flex-col rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-hover"
            >
              <time datetime={p.data.publishDate.toISOString()} class="text-xs text-stone">
                {formatDate(p.data.publishDate)}
              </time>
              <h3 class="mt-2 font-display text-lg font-bold text-dark-brown transition-colors group-hover:text-olive-dark">
                {p.data.title}
              </h3>
              <p class="mt-2 flex-1 line-clamp-3 text-sm leading-relaxed text-stone">
                {p.data.description}
              </p>
              <span class="mt-4 text-sm font-semibold text-olive-dark">Read →</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
