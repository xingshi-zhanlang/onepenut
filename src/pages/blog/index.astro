---
// 博客索引页 /blog/
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${SITE.name} Sourcing Guides`,
  url: `${SITE.url}/blog/`,
  description:
    'Practical guides on pet product sourcing, materials, sizing and private label manufacturing.',
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    datePublished: p.data.publishDate.toISOString(),
    author: { '@type': 'Organization', name: SITE.name },
    url: `${SITE.url}/blog/${p.slug}/`,
  })),
});
---

<Layout
  title="Pet Product Sourcing Guides"
  description="Practical guides on pet product sourcing: carrier sizing, materials, private label manufacturing, MOQ and sampling — written for importers, retailers and brand owners."
>
  <script type="application/ld+json" set:html={schema}></script>

  <section class="border-b border-milk-tea/60 bg-white/50">
    <div class="container-site py-8 md:py-12">
      <nav class="flex flex-wrap items-center gap-2 text-sm text-stone" aria-label="Breadcrumb">
        <a href="/" class="hover:text-olive-dark">Home</a>
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
        <span class="text-dark-brown">Guides</span>
      </nav>

      <div class="mt-8 max-w-3xl">
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">Guides</span>
        <h1 class="mt-3 font-display text-4xl font-bold text-dark-brown md:text-5xl">
          Sourcing notes from the factory floor
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone">
          Practical writing on sizing, materials, sampling and private label
          manufacturing — the questions buyers actually ask us, answered in
          full.
        </p>
      </div>
    </div>
  </section>

  <section class="container-site py-14 md:py-20">
    {posts.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}/`}
            class="group flex flex-col rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-hover"
          >
            <div class="flex items-center gap-3 text-xs text-stone">
              <time datetime={post.data.publishDate.toISOString()}>
                {formatDate(post.data.publishDate)}
              </time>
              <span class="h-1 w-1 rounded-full bg-milk-tea"></span>
              <span>Guide</span>
            </div>
            <h2 class="mt-3 font-display text-xl font-bold text-dark-brown transition-colors group-hover:text-olive-dark">
              {post.data.title}
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-stone">
              {post.data.description}
            </p>
            <span class="mt-5 border-t border-milk-tea/40 pt-4 text-sm font-semibold text-olive-dark">
              Read the guide →
            </span>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-3xl border border-milk-tea/60 bg-white p-10 text-center shadow-card">
        <p class="text-lg font-medium text-dark-brown">Guides are on the way.</p>
        <p class="mt-2 text-sm text-stone">
          In the meantime, tell us what you are sourcing and we will answer directly.
        </p>
        <a href="/contact" class="btn-caramel mt-6">Contact us</a>
      </div>
    )}

    <div class="mt-14 rounded-3xl border border-milk-tea/60 bg-white p-8 text-center shadow-card md:p-10">
      <h2 class="font-display text-2xl font-bold text-dark-brown md:text-3xl">
        Have a sourcing question we have not covered?
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-stone">
        Send us your product, target market and timeline. We will answer with
        specifics rather than generalities.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/quote" class="btn-caramel">Request a Quote</a>
        <a href="/collections/" class="inline-flex items-center gap-2 rounded-full border border-milk-tea px-5 py-2.5 text-sm font-semibold text-stone transition-colors hover:border-olive hover:text-olive-dark">
          Browse collections
        </a>
      </div>
    </div>
  </section>
</Layout>
