---
// 首页：Hero + 品牌理念 + 品类导航 + 精选产品 + 优势 + 评价 + CTA
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { getCollection } from 'astro:content';
import { ADVANTAGES, CATEGORIES, CONTACT, SITE, TESTIMONIALS, whatsappLink } from '../consts';

const products = await getCollection('products');
const featured = products.slice(0, 3);
const quoteMsg =
  'Hello ONEPENUT, I would like to get a quote for your pet travel products.';
const quoteLink = whatsappLink(quoteMsg);
---

<Layout>
  <Hero />

  <!-- 品牌理念 -->
  <section class="container-site py-16 md:py-20">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="relative">
        <div class="overflow-hidden rounded-[2rem] border border-milk-tea/60 bg-white/60 shadow-card">
          <img
            src="/images/products/first-class-cat-backpack-1.webp"
            alt="Pet riding safely in an ONEPENUT carrier backpack"
            class="aspect-[4/3] h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <svg class="absolute -left-6 -top-6 h-20 w-20 text-olive/20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
        </svg>
      </div>

      <div>
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">
          Our Design Philosophy
        </span>
        <h2 class="mt-3 font-display text-3xl font-bold leading-tight text-dark-brown md:text-4xl">
          Comfort and safety, in every journey
        </h2>
        <p class="mt-5 text-base leading-relaxed text-stone">
          ONEPENUT believes that travel with pets should be calm, comfortable
          and worry-free. Every product is designed around pet anatomy and
          behavior, using eco-friendly materials and thoughtful construction.
        </p>
        <p class="mt-3 text-base leading-relaxed text-stone">
          From airline-approved carriers to no-pull harnesses, our collections
          combine natural aesthetics with functional reliability — so pets and
          their humans can roam freely, together.
        </p>

        <div class="mt-7 grid grid-cols-2 gap-4">
          <div class="rounded-2xl border border-milk-tea/60 bg-white/60 p-4">
            <p class="font-display text-2xl font-bold text-olive">100%</p>
            <p class="mt-1 text-xs text-stone">Pet-friendly design</p>
          </div>
          <div class="rounded-2xl border border-milk-tea/60 bg-white/60 p-4">
            <p class="font-display text-2xl font-bold text-olive">Eco</p>
            <p class="mt-1 text-xs text-stone">Recycled fabrics</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 产品系列导航 -->
  <section class="container-site py-16 md:py-20">
    <div class="flex flex-col items-center text-center">
      <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">
        Collections
      </span>
      <h2 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl">
        Explore our product lines
      </h2>
      <p class="mt-3 max-w-2xl text-stone">
        A curated range covering carriers, harnesses and travel essentials —
        ready for wholesale, OEM and ODM.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {CATEGORIES.map((c) => (
        <a
          href={`/products?category=${c.slug}`}
          class="group relative overflow-hidden rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-hover"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-olive/10 text-olive-dark">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={c.icon}></path>
            </svg>
          </div>
          <h3 class="mt-4 font-display text-lg font-bold text-dark-brown group-hover:text-olive-dark">
            {c.name}
          </h3>
          <p class="mt-1 text-xs font-medium uppercase tracking-wide text-caramel">
            {c.tagline}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-stone">{c.description}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-olive-dark">
            View line
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 精选产品 -->
  <section class="bg-white/50 py-16 md:py-20">
    <div class="container-site">
      <div class="flex flex-col items-center text-center">
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">
          Featured
        </span>
        <h2 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl">
          Bestsellers for travel
        </h2>
        <p class="mt-3 max-w-2xl text-stone">
          Popular picks loved by pet parents and trusted by retailers worldwide.
        </p>
      </div>

      <div class="mt-12">
        <ProductGrid products={featured} />
      </div>

      <div class="mt-10 text-center">
        <a href="/products" class="btn-caramel">
          View All Products
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 优势 -->
  <section class="container-site py-16 md:py-20">
    <div class="flex flex-col items-center text-center">
      <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">
        Why ONEPENUT
      </span>
      <h2 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl">
        A trusted partner for your brand
      </h2>
      <p class="mt-3 max-w-2xl text-stone">
        We support global retailers, brands and distributors with quality
        products and reliable service.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {ADVANTAGES.map((a) => (
        <div class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-olive/10 text-olive-dark">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={a.icon}></path>
            </svg>
          </div>
          <h3 class="mt-4 font-display text-lg font-bold text-dark-brown">{a.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone">{a.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 信任背书（参考 Tuft&Paw 用数字建立信任） -->
  <section class="bg-gradient-to-br from-olive to-olive-dark py-14 md:py-16">
    <div class="container-site">
      <div class="grid gap-8 text-center md:grid-cols-4">
        <div>
          <p class="font-display text-3xl font-bold text-cream md:text-4xl">5+</p>
          <p class="mt-2 text-sm text-cream/70">Product Lines</p>
        </div>
        <div>
          <p class="font-display text-3xl font-bold text-cream md:text-4xl">100+</p>
          <p class="mt-2 text-sm text-cream/70">SKUs for Wholesale</p>
        </div>
        <div>
          <p class="font-display text-3xl font-bold text-cream md:text-4xl">20+</p>
          <p class="mt-2 text-sm text-cream/70">Export Countries</p>
        </div>
        <div>
          <p class="font-display text-3xl font-bold text-cream md:text-4xl">24h</p>
          <p class="mt-2 text-sm text-cream/70">Response Time</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 全球发货 -->
  <section class="container-site py-16 md:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">Global Reach</span>
        <h2 class="mt-3 font-display text-3xl font-bold leading-tight text-dark-brown md:text-4xl">
          Ships worldwide, wholesale made easy
        </h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-stone">
          ONEPENUT pet travel gear ships to retailers and wholesale partners
          across North America, Europe and Asia. Reliable global logistics,
          flexible order terms and full OEM / ODM support — wherever your
          business is.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <span class="rounded-full border border-milk-tea bg-white px-4 py-2 text-sm font-medium text-dark-brown">Wholesale</span>
          <span class="rounded-full border border-milk-tea bg-white px-4 py-2 text-sm font-medium text-dark-brown">OEM / ODM</span>
          <span class="rounded-full border border-milk-tea bg-white px-4 py-2 text-sm font-medium text-dark-brown">Global Logistics</span>
          <span class="rounded-full border border-milk-tea bg-white px-4 py-2 text-sm font-medium text-dark-brown">Ships Worldwide</span>
        </div>
        <div class="mt-8">
          <a href="/products" class="btn-caramel text-base">
            Explore the catalog
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
      <div class="relative">
        <div class="overflow-hidden rounded-[2rem] border border-milk-tea/60 bg-white/60 shadow-card">
          <img
            src="/images/products/airline-pet-tote-travel-bag-1.webp"
            alt="ONEPENUT airline-approved pet tote travel bag, carried for a trip"
            class="aspect-[4/3] h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 工厂实力 -->
  <section class="container-site py-16 md:py-20">
    <div class="flex flex-col items-center text-center">
      <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">
        Our Factory
      </span>
      <h2 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl">
        In-house production, quality controlled
      </h2>
      <p class="mt-3 max-w-2xl text-stone">
        From fabric to finished product under one roof — with strict QC at
        every stage and OEM / ODM support for your private label.
      </p>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      <div class="group overflow-hidden rounded-3xl border border-milk-tea/60 bg-white shadow-card lg:col-span-2">
        <div class="grid md:grid-cols-2">
          <div class="aspect-[4/3] overflow-hidden bg-milk-tea/30">
            <img
              src="/images/placeholders/factory-workshop.svg"
              alt="Factory workshop and sewing lines"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col justify-center p-8">
            <h3 class="font-display text-xl font-bold text-dark-brown">
              Sewing & assembly lines
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-stone">
              Carriers, harnesses and soft goods produced in-house with
              dedicated cutting, sewing and assembly stations. We control
              quality and lead time end to end.
            </p>
            <ul class="mt-5 space-y-2 text-sm text-stone">
              <li class="flex items-center gap-2">
                <svg class="h-4 w-4 shrink-0 text-olive-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4M21 12c0 5-3.5 7.5-8.5 9.5C7.5 19.5 4 17 4 12V6l8.5-3.5L21 6v6z"/></svg>
                Material, in-line & pre-shipment QC
              </li>
              <li class="flex items-center gap-2">
                <svg class="h-4 w-4 shrink-0 text-olive-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4M21 12c0 5-3.5 7.5-8.5 9.5C7.5 19.5 4 17 4 12V6l8.5-3.5L21 6v6z"/></svg>
                OEM / ODM — colors, logos, packaging
              </li>
              <li class="flex items-center gap-2">
                <svg class="h-4 w-4 shrink-0 text-olive-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4M21 12c0 5-3.5 7.5-8.5 9.5C7.5 19.5 4 17 4 12V6l8.5-3.5L21 6v6z"/></svg>
                Export & FBA preparation support
              </li>
            </ul>
            <a
              href="/factory"
              class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-olive-dark"
            >
              Tour our factory
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-5">
        {[
          {
            img: '/images/placeholders/factory-qc.svg',
            title: 'Strict quality control',
            desc: 'Four-stage QC from material to pre-shipment.',
          },
          {
            img: '/images/placeholders/factory-team.svg',
            title: 'R&D & sample team',
            desc: 'Custom pattern and sample development in-house.',
          },
        ].map((c) => (
          <div class="group flex-1 overflow-hidden rounded-3xl border border-milk-tea/60 bg-white shadow-card">
            <div class="aspect-[16/9] overflow-hidden bg-milk-tea/30">
              <img
                src={c.img}
                alt={c.title}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <h3 class="font-display text-base font-bold text-dark-brown">{c.title}</h3>
              <p class="mt-1.5 text-sm text-stone">{c.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 客户评价 -->
  <section class="bg-white/50 py-16 md:py-20">
    <div class="container-site">
      <div class="flex flex-col items-center text-center">
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-caramel">
          Testimonials
        </span>
        <h2 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl">
          Trusted by partners worldwide
        </h2>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {TESTIMONIALS.map((t) => (
          <figure class="rounded-3xl border border-milk-tea/60 bg-white p-6 shadow-card">
            <svg class="h-8 w-8 text-caramel/40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
            <blockquote class="mt-4 text-base leading-relaxed text-dark-brown">
              {t.quote}
            </blockquote>
            <figcaption class="mt-6 border-t border-milk-tea/40 pt-4">
              <p class="font-display font-bold text-dark-brown">{t.name}</p>
              <p class="mt-0.5 text-xs text-stone">{t.role}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-site py-16 md:py-24">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-olive to-olive-dark px-6 py-16 text-center shadow-card md:px-16 md:py-20">
      <div class="absolute inset-0 opacity-10">
        <svg class="absolute -left-10 -top-10 h-48 w-48 text-cream" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
        </svg>
      </div>
      <div class="relative">
        <h2 class="font-display text-3xl font-bold text-cream md:text-4xl">
          Ready to source premium pet products?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-cream/80">
          Talk to our team for wholesale pricing, custom OEM / ODM options and
          sample requests. We respond within 24 hours.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/quote" class="btn-caramel text-base">
            Request a Quote
          </a>
          <a href={quoteLink} target="_blank" rel="noopener noreferrer" class="btn-wa text-base">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.973-1.041z"/>
            </svg>
            Chat on WhatsApp
          </a>
          <a href={`mailto:${CONTACT.email}`} class="inline-flex items-center gap-2 rounded-full border-2 border-cream/40 px-5 py-2.5 text-sm font-semibold text-cream transition-colors hover:bg-cream/10">
            Email Us
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
