---
// 首页 Hero - 参考 Tuft&Paw 高端感：产品摄影 + 信任背书
import { whatsappLink } from '../consts';
const msg = 'Hello ONEPENUT, I would like to know more about your pet products.';
const link = whatsappLink(msg);
---

<section class="relative overflow-hidden bg-cream">
  <!-- 背景装饰 -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute -left-24 -top-24 h-96 w-96 rounded-full bg-olive/10 blur-3xl"></div>
    <div class="absolute -right-24 top-40 h-96 w-96 rounded-full bg-caramel/10 blur-3xl"></div>
  </div>

  <div class="container-site grid items-center gap-12 py-16 md:py-24 lg:grid-cols-2 lg:gap-16">
    <div class="text-center lg:text-left">
      <span class="inline-flex items-center gap-2 rounded-full border border-caramel/30 bg-caramel/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-caramel-dark">
        Pet Travel Essentials
      </span>
      <h1 class="mt-5 text-4xl font-bold leading-tight text-dark-brown md:text-5xl lg:text-6xl">
        Premium Pet Travel Gear, <span class="text-olive-dark">Designed for Comfort</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-stone md:text-lg">
        ONEPENUT designs comfortable, safe and stylish travel gear for cats and
        dogs. From airline-approved carriers to everyday harnesses — crafted
        for global wholesale, OEM and ODM partners.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a href="/products" class="btn-caramel text-base">
          Explore Products
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a href={link} target="_blank" rel="noopener noreferrer" class="btn-wa text-base">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.973-1.041z"/>
          </svg>
          Chat on WhatsApp
        </a>
      </div>

      <!-- 信任背书（参考 Tuft&Paw 的专家背书） -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-milk-tea/60 pt-8 lg:justify-start">
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-olive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 12l2 2 4-4M21 12c0 5-3.5 7.5-8.5 9.5C7.5 19.5 4 17 4 12V6l8.5-3.5L21 6v6z"></path>
          </svg>
          <span class="text-sm font-medium text-dark-brown">Quality Tested</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-olive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM9 22V12h6v10"></path>
          </svg>
          <span class="text-sm font-medium text-dark-brown">Global Shipping</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-olive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z M2 21c0-3 1.85-5.36 5.08-6"></path>
          </svg>
          <span class="text-sm font-medium text-dark-brown">Eco Materials</span>
        </div>
      </div>
    </div>

    <!-- 右侧产品摄影（真实图片） -->
    <div class="relative">
      <div class="overflow-hidden rounded-[2rem] border border-milk-tea/60 bg-white shadow-card">
        <img
          src="/images/products/spine-friendly-pet-backpack-carry-sideways-home.webp"
          alt="Premium pet backpack in a cozy home setting"
          class="aspect-[4/3] h-full w-full object-cover"
          loading="eager"
        />
      </div>

      <!-- 浮动小卡片 -->
      <div class="absolute -bottom-5 -left-4 rounded-2xl border border-milk-tea/60 bg-white/95 px-5 py-4 shadow-soft backdrop-blur md:-left-8">
        <p class="text-xs text-stone">Airline Approved</p>
        <p class="font-display text-lg font-bold text-olive-dark">Safe Travel</p>
      </div>
      <div class="absolute -top-4 -right-2 rounded-2xl border border-milk-tea/60 bg-white/95 px-5 py-4 shadow-soft backdrop-blur md:-right-6">
        <p class="text-xs text-stone">Trusted Quality</p>
        <p class="font-display text-lg font-bold text-caramel-dark">100+ SKUs</p>
      </div>
    </div>
  </div>
</section>
