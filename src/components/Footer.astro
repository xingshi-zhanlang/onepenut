---
// 页脚
import { CONTACT, NAV_LINKS, SITE, whatsappLink } from '../consts';
const contactMsg = 'Hello ONEPENUT, I have a question about your products.';
---

<footer class="border-t border-milk-tea/60 bg-white/50">
  <div class="container-site grid gap-10 py-14 md:grid-cols-4">
    <!-- 品牌 -->
    <div class="md:col-span-2">
      <div class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-olive text-cream">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
          </svg>
        </span>
        <span class="font-display text-lg font-bold text-dark-brown">{SITE.name}</span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-stone">
        Premium pet carriers, harnesses and travel essentials for cats and dogs.
        Wholesale, OEM & ODM — made with quality and care.
      </p>
      <div class="mt-5 flex gap-3">
        <a href={whatsappLink(contactMsg)} target="_blank" rel="noopener noreferrer" class="btn-wa text-xs">
          WhatsApp
        </a>
        <a href={`mailto:${CONTACT.email}`} class="inline-flex items-center gap-2 rounded-full border border-milk-tea px-4 py-2.5 text-xs font-semibold text-stone transition-colors hover:border-olive hover:text-olive-dark">
          Email
        </a>
      </div>
    </div>

    <!-- 导航 -->
    <div>
      <h3 class="text-sm font-semibold text-dark-brown">Explore</h3>
      <ul class="mt-4 space-y-2.5">
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-stone transition-colors hover:text-olive-dark">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- 联系 -->
    <div>
      <h3 class="text-sm font-semibold text-dark-brown">Contact</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-stone">
        <li>
          <a href={whatsappLink(contactMsg)} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-olive-dark">
            {CONTACT.whatsappDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${CONTACT.email}`} class="transition-colors hover:text-olive-dark">
            {CONTACT.email}
          </a>
        </li>
        <li>{CONTACT.address}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-milk-tea/60">
    <div class="container-site flex flex-col items-center justify-between gap-2 py-5 text-xs text-stone md:flex-row">
      <span>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</span>
      <span>B2B Wholesale · OEM / ODM</span>
    </div>
  </div>
</footer>
