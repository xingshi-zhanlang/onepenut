---
// 全局布局：Header + 内容 + Footer + WhatsApp 悬浮按钮
// SEO：canonical、OG 标签、Twitter Card、结构化数据
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { CONTACT, SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  robots?: string;
}
const { title, description, image, type, robots = 'index, follow, max-image-preview:large' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const pageDesc = description || SITE.description;

// canonical URL（基于当前请求地址）
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;

// ---------------------------------------------------------------------------
// 搜索引擎站长平台「所有权验证」标签
// 在 Cloudflare Pages 的 Environment variables 里配置即可，无需改代码：
//   PUBLIC_GOOGLE_SITE_VERIFICATION  Google Search Console
//   PUBLIC_BING_SITE_VERIFICATION    Bing Webmaster Tools
//   PUBLIC_YANDEX_VERIFICATION       Yandex Webmaster
//   PUBLIC_BAIDU_VERIFICATION        百度搜索资源平台
// 未配置时对应标签不会输出，页面不受影响。
// ---------------------------------------------------------------------------
const verifications: { name: string; value: string | undefined }[] = [
  { name: 'google-site-verification', value: import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION },
  { name: 'msvalidate.01', value: import.meta.env.PUBLIC_BING_SITE_VERIFICATION },
  { name: 'yandex-verification', value: import.meta.env.PUBLIC_YANDEX_VERIFICATION },
  { name: 'baidu-site-verification', value: import.meta.env.PUBLIC_BAIDU_VERIFICATION },
];
const activeVerifications = verifications.filter((v) => Boolean(v.value));

// OG 图片（默认用品牌字母 Logo 分享图，可用 props 覆盖）
const ogImage = image
  ? new URL(image, SITE.url).href
  : `${SITE.url}/og-default.png`;

// 结构化数据：Organization + WebSite
const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      email: CONTACT.email,
    },
    {
      '@type': 'WebSite',
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- 搜索引擎站长平台验证（由环境变量驱动，未配置则不输出） -->
    {activeVerifications.map((v) => <meta name={v.name} content={v.value} />)}

    <!-- Open Graph -->
    <meta property="og:type" content={type || 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon：字母 Logo 多尺寸 -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- 字体异步加载（避免阻塞首屏渲染） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- 结构化数据 -->
    <script type="application/ld+json" set:html={orgSchema}></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
